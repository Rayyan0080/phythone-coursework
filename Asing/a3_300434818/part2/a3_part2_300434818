# 8. Function to encrypt a string by reversing it and interleaving characters
def encrypt(s):
    """
    Encrypts a string by reversing it and interleaving characters from both ends.
    """
    reversed_s = s[::-1]
    result = ''
    length = len(reversed_s)
    for i in range((length + 1) // 2):
        result += reversed_s[i]
        if i != length - 1 - i:
            result += reversed_s[length - 1 - i]
    return result


# 9. Function to insert 'O'/'P' between characters based on their case
def oPify(s):
    """
    Inserts 'O'/'P' between consecutive characters based on their case.
    If the first character is uppercase, insert 'O'; if lowercase, insert 'o'.
    If the second character is uppercase, insert 'P'; if lowercase, insert 'p'.
    """
    result = ""
    for i in range(len(s) - 1):
        result += s[i]
        if s[i].isalpha() and s[i+1].isalpha():
            if s[i].isupper():
                result += "O"
            else:
                result += "o"
            if s[i+1].isupper():
                result += "P"
            else:
                result += "p"
    result += s[-1]  # Add the last character
    return result


# 10. Function to check if a string is nonrepetitive
def nonrepetitive(s):
    """
    Returns True if string s is nonrepetitive, i.e., no consecutive repeated subwords.
    """
    length = len(s)
    for i in range(1, length // 2 + 1):
        for j in range(length - 2 * i + 1):
            if s[j:j + i] == s[j + i:j + 2 * i]:
                return False
    return True


