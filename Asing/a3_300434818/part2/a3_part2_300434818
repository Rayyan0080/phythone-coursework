# 1. Function to sum all odd divisors of n
def sum_odd_divisors(n):
    """
    Returns the sum of all positive odd divisors of n.
    If n is zero, returns None.
    """
    if n == 0:
        return None
    n = abs(n)  # Convert to positive for consistent results
    total_sum = 0
    for i in range(1, n + 1, 2):  # Loop through odd numbers only
        if n % i == 0:
            total_sum += i
    return total_sum


# 2. Function to compute the sum of a series based on user input
def series_sum():
    """
    Prompts user to input a non-negative integer and returns the sum of the series:
    1000 + 1/1^2 + 1/2^2 + ... + 1/n^2.
    Returns None if input is negative.
    """
    n = int(input("Please enter a non-negative integer: "))
    if n < 0:
        return None
    total_sum = 1000
    for i in range(1, n + 1):
        total_sum += 1 / (i ** 2)
    return total_sum


# 3. Function to calculate the nth Pell number
def pell(n):
    """
    Returns the nth Pell number. Returns None if n is negative.
    Pell numbers are defined as:
        P(0) = 0
        P(1) = 1
        P(n) = 2*P(n-1) + P(n-2) for n > 1
    """
    if n < 0:
        return None
    if n == 0:
        return 0
    elif n == 1:
        return 1
    else:
        prev2, prev1 = 0, 1
        for i in range(2, n + 1):
            current = 2 * prev1 + prev2
            prev2, prev1 = prev1, current
        return current


# 4. Function to count extraordinary characters in a string
def countMembers(s):
    """
    Counts how many extraordinary characters are in string s.
    Extraordinary characters are:
    - Lowercase letters 'e' to 'j' (inclusive)
    - Uppercase letters 'F' to 'X' (inclusive)
    - Numerals '2' to '6' (inclusive)
    - Special characters: '!', ',', and '\\'
    """
    count = 0
    for char in s:
        if 'e' <= char <= 'j' or 'F' <= char <= 'X' or '2' <= char <= '6' or char in ['!', ',', '\\']:
            count += 1
    return count


# 5. Function to convert a string representing a number to an integer
def casual_number(s):
    """
    Converts a string s representing a number with commas to an integer.
    If the string is invalid, returns None.
    """
    try:
        return int(s.replace(',', ''))
    except ValueError:
        return None


