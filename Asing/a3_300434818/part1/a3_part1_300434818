def split_tester(N, d):
    d = int(d)  # Convert d to an integer for slicing purposes
    length_N = len(N)
    
    if length_N % d != 0:
        print(f"Error: The split size {d} does not divide the length of {N} ({length_N}) evenly.")
        return False
    
    # Initialize a variable to track the previous piece for comparison
    previous_piece = None
    i = 0
    
    # Loop through the string, slicing it into pieces of length 'd'
    while i < length_N:
        piece = N[i:i + d]

        # Print the pieces separated by a comma (no lists used, purely strings)
        if i > 0:
            print(", ", end="")
        print(piece, end="")
        
        # Convert the current piece to an integer for comparison
        current_piece = int(piece)

        # Check if the sequence is increasing
        if previous_piece is not None and current_piece <= previous_piece:
            print()  # Add a newline after the sequence printing
            return False  # Return False if the sequence is not strictly increasing
        
        # Update previous_piece for the next comparison
        previous_piece = current_piece
        i += d  # Increment the index by the split size
    
    print()  # Newline after printing the entire sequence
    return True  # Return True if the sequence is strictly increasing


